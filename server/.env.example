# ==========================================
# FluentUp Backend Environment Variables
# ==========================================

# 1. Application Server Configuration
# Server kis port par listen karega (Default: 3000)
PORT=3000

# Application execution mode: development, staging, production
NODE_ENV=development

# 2. Database Connection (PostgreSQL via Neon / Supabase)
# PostgreSQL connection string jo Prisma ORM use karega
# Example: postgresql://username:password@ep-cool-forest.us-east-2.aws.neon.tech/fluentup?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fluentup?schema=public"

# 3. Redis In-Memory Cache & Matchmaking Queue (Upstash / Local Redis)
# Real-time 30-second matchmaking queue aur user presence ke liye
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# 4. Firebase Admin Authentication
# Mobile client se aane wale Firebase ID token ko verify karne ke liye
FIREBASE_PROJECT_ID="fluentup-app"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@fluentup-app.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 5. Security & CORS Configuration
# Mobile app ya web client ko API access allow karne ke liye (* or https://fluentup.com)
CORS_ORIGIN="*"
